{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "apps/*/.env", "packages/typescript-config/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_BASE_URL", "VITE_AUTH_BASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "API_PORT",
        "ADMIN_URL",
        "AUTH_BASE_URL",
        "AUTH_SECRET",
        "CORS_TRUSTED_ORIGINS",
        "LOG_LEVEL",
        "VITE_API_BASE_URL",
        "VITE_AUTH_BASE_URL"
      ]
    }
  }
}
