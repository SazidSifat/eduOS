# Local development only. Run pnpm env:setup; use managed secrets and TLS in production.
NODE_ENV=development
DATABASE_URL=postgresql://eduos:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/eduos
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3001
ADMIN_URL=http://localhost:5173
AUTH_BASE_URL=http://localhost:3001
AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET
CORS_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Used only by Docker Compose; match DATABASE_URL credentials.
POSTGRES_USER=eduos
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=eduos
POSTGRES_PORT=5432
REDIS_PORT=6379
